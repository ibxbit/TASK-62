# ────────────────────────────────────────────────────────────────
# TransitOps Backoffice Platform — .gitignore
# ────────────────────────────────────────────────────────────────

# ── Rust build artefacts ─────────────────────────────────────────
/target/
frontend/target/

# Cargo lock for the root crate is kept (reproducible builds for
# a binary crate).  The frontend Cargo.lock is also kept for the
# same reason.  Remove these lines if you prefer not to commit them.
# Cargo.lock
# frontend/Cargo.lock

# ── Environment / secrets ────────────────────────────────────────
# Never commit actual credentials.  Only .env.example is committed.
.env
.env.local
.env.production
.env.staging

# ── SQLx offline query cache ─────────────────────────────────────
# Generated by `cargo sqlx prepare`.  Safe to commit for offline
# builds, but excluded here to keep the repo clean; regenerate with
# `cargo sqlx prepare` when the schema changes.
.sqlx/

# ── WASM / Trunk build output ────────────────────────────────────
frontend/dist/
# Trunk staging directory
frontend/.trunk/

# ── Python test artefacts ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
*.egg

# Python virtual environments (common names)
.venv/
venv/
env/
.env/

# ── IDE / editor files ───────────────────────────────────────────
.idea/
.vscode/
*.sw[op]
*.swp
*~
.DS_Store
Thumbs.db

# ── OS artefacts ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
desktop.ini
$RECYCLE.BIN/

# ── Docker ───────────────────────────────────────────────────────
# Locally created Docker volumes and override files
docker-compose.override.yml
docker-compose.local.yml

# ── Log files ────────────────────────────────────────────────────
*.log
logs/

# ── Temporary / generated files ──────────────────────────────────
*.tmp
*.bak
*.orig
*.rej

# ── PDF / CSV report exports ─────────────────────────────────────
sessions/
# Report files generated by the export endpoint should not be committed
reports/
exports/
*.export.pdf
*.export.csv

# ── Test coverage reports ────────────────────────────────────────
coverage/
htmlcov/
.coverage
*.lcov

# ── Sensitive DB dumps / data files ──────────────────────────────
*.sql.gz
*.dump
*.pgdump
*.pgbackup

# ── Claude / AI tool internals ───────────────────────────────────
.claude/
